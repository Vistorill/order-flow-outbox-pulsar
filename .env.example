# Copie para .env  (cp .env.example .env)
# As credenciais batem com o docker-compose.yml
DATABASE_URL=postgres://outbox:outbox@localhost:5445/outbox

# pulsar (padrão, usa o docker-compose) | memory (roda sem broker externo)
BROKER=pulsar
PULSAR_URL=pulsar://localhost:6650
PULSAR_ADMIN_URL=http://localhost:8080

PORT=3000

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_LEASE_SECONDS=15
OUTBOX_RETENTION_DAYS=7

# Webhooks para o cliente final (order.confirmed)
WEBHOOK_POLL_INTERVAL_MS=1000
WEBHOOK_BATCH_SIZE=20
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_TIMEOUT_MS=5000

# Integração com a transportadora (por padrão, o simulador em /partner)
# APP_PUBLIC_URL=http://localhost:3000
# CARRIER_API_URL=http://localhost:3000/partner
CARRIER_NAME=Transportadora Simulada
CARRIER_WEBHOOK_SECRET=whsec_carrier_demo_secret_123
CARRIER_TIMEOUT_MS=5000
CARRIER_DELIVERY_DELAY_MS=4000

# Painel em http://localhost:3000/ e rotas /debug. Desligue em produção.
DEBUG_PANEL=true
